  "corsReadableExceptions": [
    {
      "id": "duckduckgo",
      "formalAi": true,
      "webSearch": false,
      "reason": "FormalAI models the DuckDuckGo Instant Answer JSON API (CORS-readable). web-search ships an HTML-SERP scraper (html.duckduckgo.com / lite.duckduckgo.com), which is not browser-CORS-readable. The id, category, label intent, and default-for-search flag all match; only the fetch mechanism differs."
    }
  ],
